```gitignore
# Build artifacts
bin/
obj/
*.exe
*.dll
*.pdb
*.nupkg
*.userprefs

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# User-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Environment specific settings
.env
.env.local
*.local
*.userprefs

# Cache
.cache/
*.cache

# Temporary files
*.tmp
*.temp
```