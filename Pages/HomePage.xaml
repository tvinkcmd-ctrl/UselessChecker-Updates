<Page x:Class="UselessChecker.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Добро пожаловать в UselessChecker" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Современный инструмент для проверки и анализа" Style="{StaticResource SubHeaderText}"/>
            
            <Border CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#00d9ff" Opacity="0.1"/>
                </Border.Background>
                <Border BorderBrush="#00d9ff" BorderThickness="1" CornerRadius="10">
                    <StackPanel Margin="15">
                        <TextBlock Text="🚀 Быстро и надежно" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="Новый интерфейс на WPF обеспечивает высокую производительность и отсутствие визуальных багов." 
                                   Foreground="#a0a0b0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Border>
            
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                <Button Content="Начать проверку" Style="{StaticResource AccentButton}" Padding="20,12" Click="StartCheck_Click"/>
                <Button Content="Узнать больше" Style="{StaticResource ModernButton}" Padding="20,12" Margin="15,0,0,0" Click="LearnMore_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
