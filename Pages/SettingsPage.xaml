<Page x:Class="UselessChecker.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Настройки" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Параметры приложения" Style="{StaticResource SubHeaderText}"/>
            
            <Border CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#ffffff" Opacity="0.05"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Здесь будут настройки приложения" 
                               Foreground="#a0a0b0" TextAlignment="Center" Margin="0,40,0,40"/>
                    
                    <!-- Пример настроек -->
                    <StackPanel Margin="0,20">
                        <TextBlock Text="Общие" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>
                        
                        <CheckBox Content="Запускать с Windows" Foreground="#a0a0b0" Margin="0,5"/>
                        <CheckBox Content="Автоматическая проверка обновлений" Foreground="#a0a0b0" Margin="0,5"/>
                        <CheckBox Content="Показывать уведомления" Foreground="#a0a0b0" Margin="0,5"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,30,0,0">
                        <TextBlock Text="Интерфейс" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Тема оформления" Foreground="#a0a0b0" Margin="0,0,0,10"/>
                        <ComboBox Width="200" HorizontalAlignment="Left" Padding="10,8">
                            <ComboBoxItem Content="Cyber Dark" IsSelected="True"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
