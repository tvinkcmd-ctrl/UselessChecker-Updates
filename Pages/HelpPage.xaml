<Page x:Class="UselessChecker.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Помощь">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Помощь" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Информация о приложении и поддержка" Style="{StaticResource SubHeaderText}"/>
            
            <Border CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#ffffff" Opacity="0.05"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="UselessChecker v1.0" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    <TextBlock Text="Современный инструмент для проверки системы с новым интерфейсом на WPF." 
                               Foreground="#a0a0b0" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Возможности:" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,20,0,10"/>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="• Быстрый и современный интерфейс" Foreground="#a0a0b0" Margin="0,3"/>
                        <TextBlock Text="• Отсутствие визуальных багов" Foreground="#a0a0b0" Margin="0,3"/>
                        <TextBlock Text="• Высокая производительность" Foreground="#a0a0b0" Margin="0,3"/>
                        <TextBlock Text="• Glassmorphism дизайн" Foreground="#a0a0b0" Margin="0,3"/>
                    </StackPanel>
                    
                    <TextBlock Text="Поддержка:" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,20,0,10"/>
                    <TextBlock Foreground="#a0a0b0" TextWrapping="Wrap">
                        <Run Text="Если у вас возникли вопросы, обратитесь к разработчику через "/>
                        <Hyperlink NavigateUri="https://github.com/tvinkcmd-ctrl/UselessChecker-Updates" 
                                   RequestNavigate="GitHub_RequestNavigate">GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
