<Page x:Class="UselessChecker.Pages.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Статистика">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Статистика" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Результаты последних проверок" Style="{StaticResource SubHeaderText}"/>
            
            <Border CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#ffffff" Opacity="0.05"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Здесь будет отображаться статистика проверок" 
                               Foreground="#a0a0b0" TextAlignment="Center" Margin="0,40,0,40"/>
                    
                    <!-- Пример будущих элементов статистики -->
                    <Grid ColumnDefinitions="*,*,*">
                        <Border Grid.Column="0" CornerRadius="8" Padding="15" Margin="5">
                            <Border.Background>
                                <SolidColorBrush Color="#00d9ff" Opacity="0.1"/>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="0" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Проверок" FontSize="12" Foreground="#a0a0b0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" CornerRadius="8" Padding="15" Margin="5">
                            <Border.Background>
                                <SolidColorBrush Color="#7b2cbf" Opacity="0.1"/>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="0" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Найдено" FontSize="12" Foreground="#a0a0b0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="2" CornerRadius="8" Padding="15" Margin="5">
                            <Border.Background>
                                <SolidColorBrush Color="#00ff88" Opacity="0.1"/>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="100%" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Успешно" FontSize="12" Foreground="#a0a0b0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
