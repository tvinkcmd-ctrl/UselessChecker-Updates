<Window x:Class="UselessChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UselessChecker" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Эффект стекла (Glassmorphism) -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#1a1a24" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#ffffff" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стили для навигации -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="15,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фоновый градиент -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f0f13" Offset="0"/>
                    <GradientStop Color="#1a1a2e" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <!-- Декоративные элементы (светящиеся пятна) -->
        <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00d9ff" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Opacity>0.15</Ellipse.Opacity>
        </Ellipse>
        
        <Ellipse Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7b2cbf" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Opacity>0.1</Ellipse.Opacity>
        </Ellipse>

        <!-- Основное окно с эффектом стекла -->
        <Border Style="{StaticResource GlassPanel}" Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Левая панель навигации -->
                <Border Grid.Column="0" CornerRadius="15,0,0,15" Padding="0,20,0,20">
                    <Border.Background>
                        <SolidColorBrush Color="#0f0f13" Opacity="0.5"/>
                    </Border.Background>
                    
                    <DockPanel>
                        <!-- Логотип / Заголовок -->
                        <StackPanel DockPanel.Dock="Top" Margin="20,0,20,30">
                            <TextBlock Text="UselessChecker" FontSize="22" FontWeight="Bold" Foreground="White" 
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="v1.0" FontSize="12" Foreground="#a0a0b0" Margin="0,5,0,0"/>
                        </StackPanel>
                        
                        <!-- Кнопки меню -->
                        <StackPanel>
                            <Button Content="🏠 Главная" Style="{StaticResource NavButton}" Click="Home_Click"/>
                            <Button Content="🔍 Проверка" Style="{StaticResource NavButton}" Click="Check_Click"/>
                            <Button Content="📊 Статистика" Style="{StaticResource NavButton}" Click="Stats_Click"/>
                            <Button Content="⚙️ Настройки" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                            <Button Content="❓ Помощь" Style="{StaticResource NavButton}" Click="Help_Click"/>
                        </StackPanel>
                        
                        <!-- Кнопка выхода внизу -->
                        <Button Content="🚪 Выход" Style="{StaticResource NavButton}" 
                                DockPanel.Dock="Bottom" Click="Exit_Click" Margin="5,10,5,0"/>
                    </DockPanel>
                </Border>
                
                <!-- Правая часть (контент) -->
                <Grid Grid.Column="1" Margin="20">
                    <!-- Заголовок окна и кнопки управления -->
                    <Grid Height="40" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Перетаскивание окна -->
                        <Border Grid.Column="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                        
                        <!-- Кнопки управления окном -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="─" Width="30" Height="30" Style="{StaticResource ModernButton}" 
                                    Click="Minimize_Click" FontSize="16"/>
                            <Button Content="✕" Width="30" Height="30" Style="{StaticResource ModernButton}" 
                                    Click="Close_Click" FontSize="14" Foreground="#ff6b6b"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Область контента -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,0">
                        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
